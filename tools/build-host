#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
builder_image="localhost/cec-controller-builder:fedora42"
build_dir="/src/build/host"

podman build \
  --file "$project_dir/tools/Containerfile" \
  --tag "$builder_image" \
  "$project_dir/tools"

podman run --rm \
  --security-opt label=disable \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --volume "$project_dir:/src" \
  "$builder_image" \
  cmake -E remove_directory "$build_dir"

podman run --rm \
  --security-opt label=disable \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  cmake --fresh -S /src/host -B "$build_dir" -G Ninja -DCMAKE_BUILD_TYPE=Release

podman run --rm \
  --security-opt label=disable \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  cmake --build "$build_dir"

podman run --rm \
  --security-opt label=disable \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  ctest --test-dir "$build_dir" --output-on-failure

podman run --rm \
  --security-opt label=disable \
  --volume "$project_dir:/src:ro" \
  "$builder_image" \
  systemd-analyze verify \
    /src/host/systemd/cec-controller-boot.service \
    /src/host/systemd/cec-controller-sleep.service
