#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
source "$project_dir/tools/container-common"

builder_image="localhost/cec-controller-builder:fedora42"
build_dir="/src/build/tests/firmware"

"$container_engine" build \
  --file "$project_dir/tools/Containerfile" \
  --tag "$builder_image" \
  "$project_dir/tools"

"$container_engine" run \
  "${container_run_common[@]}" \
  "${container_run_user[@]}" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  cmake --fresh -S /src/tests/firmware -B "$build_dir" -G Ninja

"$container_engine" run \
  "${container_run_common[@]}" \
  "${container_run_user[@]}" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  cmake --build "$build_dir"

"$container_engine" run \
  "${container_run_common[@]}" \
  "${container_run_user[@]}" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  ctest --test-dir "$build_dir" --output-on-failure
