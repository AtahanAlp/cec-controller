#!/usr/bin/env bash

set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
builder_image="localhost/cec-controller-builder:fedora42"
build_dir="/src/build/firmware"
version="$(git -C "$project_dir" describe --always --dirty)"

podman build \
  --file "$project_dir/tools/Containerfile" \
  --tag "$builder_image" \
  "$project_dir/tools"

podman run --rm \
  --security-opt label=disable \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --volume "$project_dir:/src" \
  "$builder_image" \
  cmake -E remove_directory "$build_dir"

podman run --rm \
  --security-opt label=disable \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  cmake \
    --fresh \
    -S /src \
    -B "$build_dir" \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DPICO_BOARD=pico \
    -DCEC_PIN=11 \
    -DCEC_OSD_NAME="Couch PC" \
    -DCEC_ENABLE_DDC=OFF \
    -DCEC_ENABLE_RGB_LED=OFF \
    -DPICO_CEC_VERSION="$version"

podman run --rm \
  --security-opt label=disable \
  --userns=keep-id \
  --user "$(id -u):$(id -g)" \
  --volume "$project_dir:/src" \
  --workdir /src \
  "$builder_image" \
  cmake --build "$build_dir"
